@inject KbService Kb

@if (_loading)
{
    <div class="kb-empty"><p>正在打开文档…</p></div>
}
else if (_error is not null)
{
    <div class="kb-empty"><p>@_error</p></div>
}
else if (_content is null)
{
    <div class="kb-empty"><p>文档不存在或已被清理。</p></div>
}
else
{
    <div class="doc-layout @(_railOpen ? "rail-open" : null)">
        <div class="doc-main-col">
            <div class="doc-head">
                <span class="eyebrow">
                    @KbUi.KindLabel(_content.Doc.Kind) · v@(_content.Version.Seq)
                    @if (_viewSeq is not null && _viewSeq != _content.Doc.CurrentVersionSeq)
                    {
                        <text>· 历史版本</text>
                    }
                    · @KbUi.RelativeTime(_content.Version.CreatedAt) 修订
                </span>
                <h2 class="doc-title">@_content.Doc.Title</h2>
                <div class="doc-meta">
                    <span class="@KbUi.RetentionClass(_content.Doc.Retention)">
                        <span class="ret-dot"></span>@KbUi.RetentionLabel(_content.Doc.Retention)
                    </span>
                    @if (_refs is not null && _refs.Inbound.Count > 0)
                    {
                        <span class="ret ret-pinned"><span class="ret-dot"></span>被 @_refs.Inbound.Count 处引用</span>
                    }
                    <span class="uri-chip">@_content.Doc.Uri@@v@(_content.Version.Seq)</span>
                    <span class="meta-sep"></span>
                    <span>@KbUi.ShortId(_content.Doc.DocId)</span><span>·</span>
                    <span>@_content.Blocks.Count 个块</span><span>·</span>
                    <span>@KbUi.AuthorLabel(_content.Version.Author) 修订</span>
                    @if (_content.Doc.ExpiresAt is { } expires)
                    {
                        <span>·</span>
                        <span class="ret ret-staging">@expires.ToLocalTime().ToString("MM-dd") 到期</span>
                    }
                </div>
            </div>

            <div class="doc-toolbar">
                @if (_viewSeq is null)
                {
                    <button class="btn btn-primary btn-sm" @onclick="BeginEditFirst">
                        <Icons Name="edit" />编辑块
                    </button>
                }
                else
                {
                    <button class="btn btn-ghost btn-sm" @onclick="BackToCurrent">回到当前版本</button>
                }

                <button class="btn btn-ghost btn-sm rail-toggle" @onclick="ToggleRail">
                    @(_railOpen ? "收起详情" : "版本与引用")
                </button>
            </div>

            @if (_saveError is not null)
            {
                <div class="kb-alert">@_saveError</div>
            }

            <div class="body-blocks">
                @foreach (var block in _content.Blocks)
                {
                    <div class="blk @(block.BlockId == FocusBlockId ? "blk-target" : null)">
                        <span class="blk-anchor">@KbUi.BlockAnchor(block)</span>

                        @if (_editingBlockId == block.BlockId)
                        {
                            <textarea class="kb-editor" @bind="_editText" rows="8"></textarea>
                            <input class="kb-input" placeholder="为什么改（可空）" @bind="_editRationale" />
                            <div class="kb-edit-actions">
                                <button class="btn btn-primary btn-sm" disabled="@_saving" @onclick="SaveEdit">
                                    @(_saving ? "保存中…" : "保存为新版本")
                                </button>
                                <button class="btn btn-ghost btn-sm" @onclick="CancelEdit">取消</button>
                            </div>
                        }
                        else if (block.IsHeading)
                        {
                            <h2>@block.Text</h2>
                        }
                        else
                        {
                            <p>@block.Text</p>
                        }
                    </div>
                }
            </div>

            <div class="doc-foot">
                <div class="rail-label">我引用谁</div>
                @if (_refs is null || _refs.Outbound.Count == 0)
                {
                    <p class="muted">没有出链。</p>
                }
                else
                {
                    <div class="foot-chips">
                        @foreach (var link in _refs.Outbound)
                        {
                            <button class="ref-chip @(link.Stale ? "is-stale" : null)" @onclick="() => OpenRef(link)">
                                <Icons Name="link" />
                                <span>@(string.IsNullOrWhiteSpace(link.Title) ? link.ToUri : link.Title)</span>
                                @if (link.Stale)
                                {
                                    <small>来源已变更</small>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <aside class="doc-rail">
            <div class="rail-block">
                <div class="rail-label">版本链</div>
                <div class="vchain">
                    @foreach (var version in _versions)
                    {
                        <button class="vnode @(version.Seq == _content.Version.Seq ? "current" : null)"
                                @onclick="() => OpenVersion(version.Seq)">
                            <strong>v@(version.Seq)</strong>
                            <small>@KbUi.AuthorLabel(version.Author) · @KbUi.RelativeTime(version.CreatedAt)</small>
                            @if (version.Seq == _content.Doc.CurrentVersionSeq)
                            {
                                <small class="vnode-current">当前</small>
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="rail-block">
                <div class="rail-label">谁引用了它</div>
                @if (_refs is null || _refs.Inbound.Count == 0)
                {
                    <p class="muted">还没有引用。</p>
                }
                else
                {
                    @foreach (var link in _refs.Inbound)
                    {
                        <div class="ref-row">
                            <span class="ref-owner">@link.OwnerApp</span>
                            <span class="ref-rel">@link.Rel</span>
                            @if (link.Stale || link.BlockMissing)
                            {
                                <span class="ret ret-staging"><span class="ret-dot"></span>来源已变更</span>
                            }
                        </div>
                    }
                }
            </div>

            <div class="rail-block">
                <div class="rail-label">变更理由</div>
                @if (_changes is null || _changes.Changes.Count == 0)
                {
                    <p class="muted">还没有变更记录。</p>
                }
                else
                {
                    @foreach (var change in _changes.Changes.Take(8))
                    {
                        <div class="reason-item">
                            <div class="reason-who">
                                v@(change.VersionSeq) · @(change.RationaleSource?.ToString() ?? "system")
                                <small>@KbUi.RelativeTime(change.CreatedAt)</small>
                            </div>
                            <div class="reason-text">@(string.IsNullOrWhiteSpace(change.Rationale) ? "（未填理由）" : change.Rationale)</div>
                        </div>
                    }
                }
            </div>
        </aside>
    </div>
}

@code {
    private DocContent? _content;
    private RefsResult? _refs;
    private IReadOnlyList<VersionSummary> _versions = [];
    private ChangesResult? _changes;
    private int? _viewSeq;
    private string? _error;
    private bool _loading;

    private string? _editingBlockId;
    private string _editText = string.Empty;
    private string _editRationale = string.Empty;
    private bool _saving;
    private string? _saveError;
    private bool _railOpen = false;

    private string? _loadedDocId;

    [Parameter] public string DocId { get; set; } = string.Empty;

    [Parameter] public string? FocusBlockId { get; set; }

    [Parameter] public EventCallback<string> OnOpenDoc { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_loadedDocId, DocId, StringComparison.Ordinal))
        {
            _loadedDocId = DocId;
            _viewSeq = null;
            _editingBlockId = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var docId = DocId;
            var seq = _viewSeq;
            var content = await Task.Run(() => Kb.Get(new KbGetRequest
            {
                DocId = docId,
                Version = seq is null ? null : "v" + seq,
            }));

            if (content is null)
            {
                _content = null;
                _error = "文档或版本不存在。";
                return;
            }

            var refs = await Task.Run(() => Kb.Refs(docId));
            var versions = await Task.Run(() => Kb.History(docId, 50));
            var changes = await Task.Run(() => Kb.Changes(new KbChangesRequest { DocId = docId, Limit = 20 }));

            _content = content;
            _refs = refs;
            _versions = versions;
            _changes = changes;
        }
        catch (Exception ex)
        {
            _error = $"打开失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BeginEditFirst()
    {
        var block = _content?.Blocks.FirstOrDefault(item => !item.IsHeading) ?? _content?.Blocks.FirstOrDefault();
        if (block is null)
        {
            return;
        }

        _editingBlockId = block.BlockId;
        _editText = block.Text;
        _editRationale = string.Empty;
        _saveError = null;
    }

    private void CancelEdit()
    {
        _editingBlockId = null;
        _saveError = null;
    }

    private async Task SaveEdit()
    {
        if (_content is null || _editingBlockId is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            var blockId = _editingBlockId;
            var text = _editText;
            var rationale = string.IsNullOrWhiteSpace(_editRationale) ? "界面编辑" : _editRationale.Trim();
            var expected = _content.Version.Seq;
            var docId = _content.Doc.DocId;

            await Task.Run(() => Kb.Update(
                new KbUpdateRequest
                {
                    DocId = docId,
                    ExpectedVersion = expected,
                    Rationale = rationale,
                    Reason = rationale,
                    RationaleSource = RationaleSource.User,
                    Ops =
                    [
                        new BlockInput
                        {
                            Op = ChangeOp.Replace,
                            BlockId = blockId,
                            Text = text,
                        },
                    ],
                },
                "sdemo.kb"));

            _editingBlockId = null;
            _viewSeq = null;
            await LoadAsync();
        }
        catch (KbException ex)
        {
            _saveError = ex.Code == KbErrorCodes.VersionConflict
                ? "文档已经被改过，请先看最新版本再编辑。"
                : ex.Message;
        }
        catch (Exception ex)
        {
            _saveError = $"保存失败：{ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task OpenVersion(int seq)
    {
        _viewSeq = seq;
        _editingBlockId = null;
        await LoadAsync();
    }

    private async Task BackToCurrent()
    {
        _viewSeq = null;
        _editingBlockId = null;
        await LoadAsync();
    }

    private void ToggleRail() => _railOpen = !_railOpen;

    private async Task OpenRef(RefView link)
    {
        if (KbUri.TryParse(link.ToUri, out var uri, out _) && uri is not null)
        {
            await OnOpenDoc.InvokeAsync(uri.DocId);
        }
    }
}


